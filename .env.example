# ============================================================================
# Boulder Rollers - Environment Variables
# ============================================================================
# This file documents all environment variables used across the project.
# Copy to .env and fill in your values.
# ============================================================================

# ============================================================================
# BACKEND (backend/)
# ============================================================================

# --- Database ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname  # Direct Postgres connection (optional)
SUPABASE_URL=https://your-project.supabase.co               # Supabase project URL
SUPABASE_SERVICE_KEY=sb_secret_your-server-key-here         # Modern server-only API key (admin access)
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-jwt-here            # Temporary compatibility alias during migration only

# One-use, non-secret approvals for guarded migration 153. Leave empty during
# ordinary releases and set all three only after reviewing the exact migration
# bytes, Supabase project, and current catalog fingerprint.
APPROVED_PUBLIC_DATA_API_RLS_SHA256=
APPROVED_PUBLIC_DATA_API_RLS_PROJECT_REF=
APPROVED_PUBLIC_DATA_API_RLS_CATALOG_SHA256=

# --- Authentication ---
# JWT signing secrets (generate with: openssl rand -hex 32)
ACCESS_TOKEN_SECRET=your-access-token-secret-here           # REQUIRED: Secret for signing access tokens
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here         # REQUIRED: Secret for signing refresh tokens
# JWT_SECRET=your-jwt-secret-here                           # Fallback if ACCESS/REFRESH secrets not set

# JWT configuration
AUTH_AUDIENCE=boulderrollers                                # JWT audience claim (default: boulderrollers)
AUTH_ACCESS_TOKEN_MINUTES=15                                # Access token expiry in minutes (default: 15)
AUTH_REFRESH_TOKEN_DAYS=14                                  # Refresh token expiry in days (default: 14)
AUTH_NONCE_TTL_SECONDS=300                                  # Nonce TTL for wallet auth (default: 300)
AUTH_COOKIE_SECURE=false                                    # Non-production default; production forces secure cookies
AUTH_COOKIE_SAMESITE=lax                                    # Cookie SameSite policy
AUTH_SIGNATURE_BYPASS=false                                 # DEVELOPMENT ONLY: bypass signature verification

# --- Strava Integration (optional) ---
STRAVA_CLIENT_ID=your-strava-client-id                      # Get from https://www.strava.com/settings/api
STRAVA_CLIENT_SECRET=your-strava-client-secret              # Get from Strava API settings
STRAVA_SYNC_ENABLED=false                                   # File-import-only is fail-closed; true re-enables retired OAuth/webhook ingest
STRAVA_REDIRECT_URI=https://app.boulderroller.xyz/strava/callback  # Must match Strava app config
STRAVA_WEBHOOK_VERIFY_TOKEN=your-random-verify-token        # Shared secret for Strava webhook validation
STRAVA_WEBHOOK_CALLBACK_URL=https://api.boulderroller.xyz/strava/webhook  # Public webhook URL

# --- Privy Authentication (social login) ---
PRIVY_APP_ID=your-privy-app-id                              # REQUIRED: Get from Privy dashboard
PRIVY_VERIFICATION_KEY=your-privy-verification-key          # REQUIRED: Get from Privy dashboard

# --- Environment ---
ENVIRONMENT=development                                     # production | development | test

# --- Monitoring ---
# SENTRY_DSN=https://key@o0.ingest.sentry.io/0              # Optional: API error tracking; off when unset
# PROMETHEUS_METRICS_TOKEN=                                 # Bearer token Prometheus presents to /metrics (openssl rand -hex 32)
# In development mode, Solana calls return stub responses

# --- Solana Configuration ---
SOLANA_RPC_URL=https://api.devnet.solana.com               # Solana RPC endpoint
SOLANA_PAYER_SECRET=[1,2,3,...]                            # JSON array of fee-payer keypair bytes
# SOLANA_PAYER_PATH=~/.config/solana/boulderroller-fee-payer.json  # Alternative: path to fee-payer / sponsor keypair file
# SOLANA_BACKEND_AUTHORITY_SECRET=[1,2,3,...]              # Optional separate backend-authority signer
# SOLANA_BACKEND_AUTHORITY_PATH=~/.config/solana/boulderroller-backend-authority.json  # Preferred backend authority path
# EXPECTED_BACKEND_AUTHORITY=                              # Optional base58 assertion guard for backend authority
SOLANA_STUB=false                                          # Force stub responses (no RPC calls)

# Solana Program IDs (devnet defaults provided)
BOULDER_ROLLERS_PROGRAM_ID=EVjP2Vdz9buHNphywPhoybf213poa8EiSW6FGbXWFqYH
DUNG_MINT_PROGRAM_ID=A1pDYofjye4TUYNLvM3T6rBaDygQasqKmXmgVLjvLCkZ
PROOF_VERIFIER_PROGRAM_ID=Bd3oT5xavVXpYTwYQ8ZbE6VphGt8Pg48aD4sojTwiiaC
DUNG_MINT_ADDRESS=CqDFJWLpr49tB8xjHegy5JR5jwMCfmhicjuWawtKLeCk
CAL_MINT_ADDRESS=4bxTCxEQp993cXs5nqhfWthRCPSTDv5K6PMgsfunEaJh
CAL_MINT_PUBKEY=4bxTCxEQp993cXs5nqhfWthRCPSTDv5K6PMgsfunEaJh
INDEXER_IDL_PATH=/app/idl/boulder_rollers.devnet.json      # Devnet ELF interface; unset for the mainnet build

# --- Stage 1 keeper (compose service `keeper`; off unless enabled) ---
STAGE1_KEEPER_ENABLED=false
STAGE1_KEEPER_ALLOWED_CLUSTERS=localnet                    # devnet on the devnet host; mainnet needs its own release gate
STAGE1_KEEPER_PUBLISHER_KEYS=                              # {"localnet":"…","devnet":"…","mainnet-beta":"…"}, all distinct
STAGE1_KEEPER_PUBLISHER_KEYPAIR_FILE=                      # Host path, outside the checkout, owned by uid 1000, mode 400
STAGE1_KEEPER_EXPORT_HOST_DIR=                             # Host proof directory owned by uid 1000, mode 700
# STAGE1_KEEPER_RPC_URL=                                   # Defaults to SOLANA_RPC_URL
# STAGE1_KEEPER_DATABASE_URL=                              # Defaults to DATABASE_URL (session pooler, port 5432)

# --- Celery / Redis ---
REDIS_URL=redis://localhost:6379/0                         # Redis connection for Celery broker/backend
CELERY_METRICS_PORT=                                       # Prometheus metrics port for Celery (optional)

# --- Feature Flags ---
USE_RUST_PARSER=true                                       # Use Rust workout-parse instead of Python

# --- Rate Limiting ---
RATE_LIMIT_MULTIPLIER=1.0                                  # Multiplier for rate limits (1.0 = default)
BALANCE_ACTION_BUDGETS_ENABLED=true                       # Enforce Balance sponsored-action budgets
BALANCE_RIDER_DAILY_ACTION_BUDGET=                         # Optional default per-rider daily budget for Balance actions
BALANCE_RIDER_DAILY_COLLECT_DUNG_BUDGET=12                 # Per-rider daily Collect DUNG sponsored actions
BALANCE_RIDER_DAILY_DEPOSIT_CAL_BUDGET=8                   # Per-rider daily Deposit CAL sponsored actions
BALANCE_RIDER_DAILY_WITHDRAW_CAL_BUDGET=8                  # Per-rider daily Withdraw CAL sponsored actions
BALANCE_RIDER_DAILY_CREATE_VAULT_BUDGET=3                  # Per-rider daily Create Vault sponsored actions
BALANCE_RIDER_DAILY_PAY_USDC_BUDGET=8                      # Per-rider daily Pay USDC sponsored actions
BALANCE_GLOBAL_DAILY_ACTION_BUDGET=500                     # Global daily Balance action circuit breaker


# ============================================================================
# FRONTEND - Vite Portal (web/portal/)
# ============================================================================

VITE_API_URL=/api                                           # Same-origin API facade (proxy/rewrites to backend API)
VITE_SOLANA_RPC=https://api.devnet.solana.com             # Solana RPC for wallet operations
VITE_BOULDER_ROLLERS_PROGRAM_ID=EVjP2Vdz9buHNphywPhoybf213poa8EiSW6FGbXWFqYH
VITE_CAL_MINT_ADDRESS=4bxTCxEQp993cXs5nqhfWthRCPSTDv5K6PMgsfunEaJh
VITE_DUNG_MINT_ADDRESS=CqDFJWLpr49tB8xjHegy5JR5jwMCfmhicjuWawtKLeCk
VITE_PRIVY_APP_ID=your-privy-app-id                        # Privy App ID (enables social login)


# ============================================================================
# TELEGRAM BOT (bot/)
# ============================================================================

TELEGRAM_BOT_TOKEN=your-bot-token-here                     # REQUIRED: Telegram Bot API token
BACKEND_API_URL=https://api.boulderroller.xyz              # Backend API URL for bot
# DATABASE_URL=postgresql://user:pass@host:5432/dbname     # Optional: Postgres for bot_links persistence

# Webhook configuration (production)
USE_POLLING=true                                           # true for local dev, false for webhook
WEBHOOK_URL=https://your-domain.com/bot/webhook            # Webhook URL (when USE_POLLING=false)
WEBHOOK_SECRET_TOKEN=your-webhook-secret                   # Secret for Telegram webhook verification
HOST=0.0.0.0                                               # Host to bind (default: 0.0.0.0)
PORT=8081                                                  # Port for webhook server (default: 8081)

# Notifications
NOTIFY_INTERVAL_SECONDS=180                                # Interval for notification checks (default: 180)
SOLSCAN_BASE=https://solscan.io                           # Base URL for transaction links


# ============================================================================
# MCP SERVER (tools/mcp-server/)
# ============================================================================

# Database connection for MCP queries
DB_HOST=db.qzkqjevawthyboymqrle.supabase.co               # Supabase Postgres host
DB_PORT=5432                                               # Database port
DB_USER=postgres                                           # Database user
DB_PASSWORD=your-db-password                               # Database password
DB_NAME=postgres                                           # Database name


# ============================================================================
# DASHBOARD TOOL (tools/dashboard/)
# ============================================================================

BR_DASH_REMOTE_HOST=root@${DROPLET_IP}                    # SSH host for remote operations
BR_DASH_LOCAL_LOG_PATH=backend/.uvicorn.log               # Local uvicorn log path
BR_DASH_LOCAL_API_BASE=http://localhost:8000              # Local API base URL
BR_DASH_REMOTE_API_BASE=http://${DROPLET_IP}:8080        # Remote API base URL
BR_DASH_LOCAL_REDIS_HOST=localhost                        # Local Redis host
BR_DASH_LOCAL_REDIS_PORT=6379                             # Local Redis port
BR_DASH_REMOTE_REDIS_HOST=${DROPLET_IP}                  # Remote Redis host
BR_DASH_REMOTE_REDIS_PORT=6379                            # Remote Redis port
BR_DASH_LOCAL_NATS_MONITOR=http://localhost:8222          # Local NATS monitor URL
BR_DASH_REMOTE_NATS_MONITOR=http://${DROPLET_IP}:8222    # Remote NATS monitor URL
BR_DASH_SOLANA_RPC_DEVNET=https://api.devnet.solana.com   # Devnet RPC URL
BR_DASH_SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com  # Mainnet RPC URL
BR_DASH_PROGRAM_BOULDER_ROLLERS=EVjP2Vdz9buHNphywPhoybf213poa8EiSW6FGbXWFqYH
BR_DASH_PROGRAM_DUNG_MINT=A1pDYofjye4TUYNLvM3T6rBaDygQasqKmXmgVLjvLCkZ
BR_DASH_PROGRAM_PROOF_VERIFIER=Bd3oT5xavVXpYTwYQ8ZbE6VphGt8Pg48aD4sojTwiiaC
