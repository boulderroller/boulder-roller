import {chromium,expect} from '@playwright/test';
import assert from 'node:assert/strict';
import {writeFile} from 'node:fs/promises';
import {profileScenario} from './profileModel';
const origin='http://localhost:4330';
const browser=await chromium.launch({headless:true});
const results:unknown[]=[];
try {for(const width of [1440,390]){
 const context=await browser.newContext({viewport:{width,height:width===1440?1000:844},hasTouch:width===390,permissions:['clipboard-read','clipboard-write']});
 const page=await context.newPage();page.setDefaultTimeout(12000);const errors:string[]=[];const outbound:string[]=[];
 page.on('pageerror',e=>errors.push(e.message));page.on('request',r=>{if(!r.url().startsWith(origin)&&!r.url().startsWith('data:'))outbound.push(r.url());});
 const current=()=>page.locator('.profile-workshop:not([hidden])>.workshop:not([hidden])');
 const frame=()=>page.frameLocator('iframe[title="Interactive Profile V2"]');
 const tap=async(locator:any)=>width===390?locator.tap():locator.click();
 const check=async(name:string,fn:()=>Promise<void>)=>{try{await fn();results.push({width,name,pass:true});console.log(`${width}: ${name}: pass`);}catch(e){results.push({width,name,pass:false,error:String(e)});console.log(`${width}: ${name}: FAIL ${String(e).slice(0,600)}`);}};
 await page.goto(origin+'/?surface=profile&variant=profile-v2&scenario=owner');await expect(frame().getByRole('heading',{name:'Dung Beetle Phoenix'})).toBeVisible();
 await check('Exact iframe sizes and Fit',async()=>{for(const [label,w,h] of [['Desktop preview',1440,1000],['Phone preview',390,844]] as const){await current().getByRole('button',{name:label,exact:true}).click();await expect.poll(()=>current().locator('iframe').evaluate((el:HTMLIFrameElement)=>[el.contentWindow!.innerWidth,el.contentWindow!.innerHeight])).toEqual([w,h]);}await current().getByRole('button',{name:'Fit window',exact:true}).click();});
 await check('Keyboard history and room return retain month and measurement',async()=>{
  await frame().getByLabel('History month').selectOption('2026-04');await frame().getByRole('button',{name:'Climbing',exact:true}).focus();await page.keyboard.press('Space');await expect(frame().getByRole('button',{name:'Climbing',exact:true})).toHaveAttribute('aria-pressed','true');await expect(frame().getByRole('complementary',{name:'Totals for rides shown'})).toContainText('1,030');
  await tap(frame().getByRole('link',{name:'Rides',exact:true}));await expect(page.getByLabel('Workshop page',{exact:true})).toHaveValue('rides');await page.goBack();await expect(page.getByLabel('Workshop page',{exact:true})).toHaveValue('profile');await expect(frame().getByLabel('History month')).toHaveValue('2026-04');await expect(frame().getByRole('button',{name:'Climbing',exact:true})).toHaveAttribute('aria-pressed','true');
 });
 await check('Owned tabs preserve distinct room owners',async()=>{for(const [label,room] of [['Training','training'],['Portfolio','portfolio']] as const){await tap(frame().getByRole('link',{name:label,exact:true}));await expect(page.getByLabel('Workshop page',{exact:true})).toHaveValue(room);await page.goBack();await expect(frame().getByLabel('History month')).toHaveValue('2026-04');}});
 await check('Profile tabs restore another room scenario instead of resetting it',async()=>{await tap(frame().getByRole('link',{name:'Rides',exact:true}));await page.locator('.baseline-workshop:not([hidden])').getByLabel('Baseline scenario',{exact:true}).selectOption('empty');await page.locator('.baseline-workshop:not([hidden]) iframe').contentFrame().getByRole('tab',{name:'Overview',exact:true}).click();await page.getByRole('button',{name:'Candidate V2',exact:true}).click();await tap(frame().getByRole('link',{name:'Rides',exact:true}));await expect(page.locator('.baseline-workshop:not([hidden])').getByLabel('Baseline scenario',{exact:true})).toHaveValue('empty');await page.goBack();});
 await check('Supplied Ride detail URL retains Profile return',async()=>{for(const [label,room,route] of [['May 4, 2026 Latest ride Morning Ride 48.2 km · 620 m climbed 1h 30m','ride-flows','/rides/ride-1']] as const){await tap(frame().getByRole('link',{name:label,exact:true}));await expect(page.getByLabel('Workshop page',{exact:true})).toHaveValue(room);assert.equal(new URL(page.url()).searchParams.get('route'),route);await expect(page.locator('.baseline-workshop:not([hidden]) iframe').contentFrame().getByText('Morning Ride',{exact:true}).first()).toBeVisible();assert.equal(JSON.parse(new URL(page.url()).searchParams.get('routeState')!).returnTo,'/profile');await page.goBack();await expect(frame().getByLabel('History month')).toHaveValue('2026-04');}});
 await check('Climb mismatch stays unavailable instead of opening a different specimen',async()=>{await tap(frame().getByRole('link',{name:'Manayunk Wall',exact:true}));await expect(frame().getByRole('heading',{name:'Climb details unavailable'})).toBeVisible();await tap(frame().getByRole('button',{name:'Return to profile'}));});
 await check('Historical section references, source widths, Squint and close focus',async()=>{
  await current().getByRole('button',{name:'Strava reference',exact:true}).click();const panel=current().getByRole('complementary',{name:'Strava reference'});
  for(const title of ['Overview','History','More history','Phone','Phone history']){await panel.getByRole('button',{name:title,exact:true}).click();await expect(panel.locator('img')).toHaveAttribute('alt',new RegExp((title.startsWith('Phone')?430:1440)+' px capture'));await expect.poll(()=>panel.locator('img').evaluate((el:HTMLImageElement)=>el.complete&&el.naturalWidth>0)).toBe(true);}
  await current().getByRole('button',{name:'Squint',exact:true}).focus();await page.keyboard.press('Space');await expect(current().locator('.preview-size')).toHaveCSS('filter','blur(5px)');await expect(panel.locator('.reference-image')).toHaveCSS('filter','blur(5px)');
  await page.screenshot({path:new URL(`./evidence/correction/harness-reference-${width}.png`,import.meta.url).pathname});await current().getByRole('button',{name:'Squint',exact:true}).click();await panel.getByRole('button',{name:'Close reference',exact:true}).click();await expect(current().getByRole('button',{name:'Strava reference',exact:true})).toBeFocused();
 });
 await check('Scoped JSON paste, file import, copy, download, rejection and restore',async()=>{
  await current().getByRole('button',{name:'Data',exact:true}).click();await current().getByRole('button',{name:'Export current scenario',exact:true}).click();const input=current().getByLabel('Profile scenario JSON');const original=JSON.parse(await input.inputValue());assert.equal(original.candidate,'profile-v2');await current().getByRole('button',{name:'Copy JSON',exact:true}).click();await expect(current().getByRole('button',{name:'Copied',exact:true})).toBeVisible();assert.deepEqual(JSON.parse(await page.evaluate(()=>navigator.clipboard.readText())),original);
  const download=page.waitForEvent('download');await current().getByRole('button',{name:'Download JSON',exact:true}).click();assert.equal((await download).suggestedFilename(),'profile-v2-owner.json');
  await input.fill(JSON.stringify({...original,room:'training'}));await current().getByRole('button',{name:'Load scenario',exact:true}).click();await expect(current().getByRole('alert')).toContainText('must match');
  const imported=profileScenario('owner');(imported.responses['GET /rides?limit=400'] as any[])[0].title='Imported summary';await input.fill(JSON.stringify(imported));await current().getByRole('button',{name:'Load scenario',exact:true}).click();await expect(frame().getByText('Imported summary',{exact:true}).first()).toBeVisible();await expect(current()).toContainText('Imported data');
  await tap(frame().getByRole('link',{name:/Latest ride Imported summary/}));await expect(frame().getByRole('heading',{name:'Ride details unavailable',exact:true})).toBeVisible();await page.keyboard.press('Escape');await expect(frame().getByRole('dialog')).not.toBeVisible();
  await current().getByRole('button',{name:'Data',exact:true}).click();await current().locator('input[type=file]').setInputFiles({name:'profile.json',mimeType:'application/json',buffer:Buffer.from(JSON.stringify(original))});await expect(frame().getByRole('heading',{name:'Dung Beetle Phoenix'})).toBeVisible();
  await current().getByRole('button',{name:'Data',exact:true}).click();await current().getByRole('button',{name:'Restore supplied scenario',exact:true}).click();assert.equal(await page.evaluate(()=>sessionStorage.getItem('br-profile-v2:owner:owner')),null);
 });
 await check('Public and private boundaries, phone tap and unavailable detail',async()=>{
  await current().getByLabel('Profile scenario',{exact:true}).selectOption('public');await expect(frame().getByRole('heading',{name:'Tim Trail'})).toBeVisible();await expect(frame().getByRole('navigation',{name:'Profile sections'}).getByRole('link')).toHaveCount(1);await tap(frame().getByRole('link',{name:/Latest ride Morning Ride/}));await expect(frame().getByRole('heading',{name:'Ride details unavailable'})).toBeVisible();await tap(frame().getByRole('button',{name:'Return to profile'}));
  await current().getByLabel('Profile scenario',{exact:true}).selectOption('private');await expect(frame().getByRole('heading',{name:'This profile is private.'})).toBeVisible();await expect(frame().getByRole('region',{name:'Rider identity'})).toHaveCount(0);await expect(frame().getByRole('link',{name:'Portfolio',exact:true})).toHaveCount(0);
 });
 await check('Loading release, error recovery and retained offline recovery',async()=>{
  await current().getByLabel('Profile scenario',{exact:true}).selectOption('loading');await expect(frame().getByRole('heading',{name:'Loading profile'})).toBeVisible();await current().getByRole('button',{name:'Release data'}).click();await expect(frame().getByRole('heading',{name:'Dung Beetle Phoenix'})).toBeVisible();
  await current().getByLabel('Profile scenario',{exact:true}).selectOption('error');await expect(frame().getByRole('heading',{name:'Profile unavailable'})).toBeVisible();await tap(frame().getByRole('button',{name:'Try again'}));await expect(frame().getByRole('heading',{name:'Dung Beetle Phoenix'})).toBeVisible();
  await current().getByLabel('Profile scenario',{exact:true}).selectOption('stale');await expect(frame().getByText('Offline · Showing last loaded profile.')).toBeVisible();await tap(frame().getByRole('button',{name:'Try again'}));await expect(frame().getByText('Offline · Showing last loaded profile.')).toHaveCount(0);
 });
 await check('Candidate V1 switch and separate Ride/Climb candidate return',async()=>{
  await current().getByLabel('Profile scenario',{exact:true}).selectOption('owner');await page.getByRole('group',{name:'Profile candidates'}).getByRole('button',{name:'V1 · Frozen implementation',exact:true}).click();await expect(page.locator('.baseline-workshop:not([hidden])')).toBeVisible();await page.getByRole('button',{name:'Candidate V2',exact:true}).click();await expect(frame().getByRole('heading',{name:'Dung Beetle Phoenix'})).toBeVisible();
  await current().getByRole('button',{name:'Provenance',exact:true}).click();for(const [label,room] of [['Ride candidates · separate data','ride'],['Climb candidates · separate data','climb']] as const){await current().getByRole('button',{name:label,exact:true}).click();await expect(page.getByLabel('Workshop page',{exact:true})).toHaveValue(room);await page.goBack();await expect(frame().getByRole('heading',{name:'Dung Beetle Phoenix'})).toBeVisible();}await current().getByRole('button',{name:'Provenance',exact:true}).click();
 });
 await check('No candidate runtime errors',async()=>assert.deepEqual(errors,[]));
 await page.screenshot({path:new URL(`./evidence/correction/harness-final-${width}.png`,import.meta.url).pathname});
 results.push({width,externalRequestCount:outbound.length,externalOrigins:[...new Set(outbound.map(u=>new URL(u).origin))]});await context.close();
 }}finally{await browser.close();await writeFile(new URL('./evidence/correction/interactions.json',import.meta.url),JSON.stringify(results,null,2));}
if(results.some((r:any)=>r.pass===false))process.exitCode=1;
