# Monitoring stack settings, read by `docker compose -f docker-compose.monitoring.yml`
# from this directory. Copy to .env (git-ignored) on the server; keep it mode 600.
GF_SECURITY_ADMIN_PASSWORD=
DROPLET_IP=
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Empty leaves postgres-exporter running without a database (pg_up 0).
POSTGRES_EXPORTER_DSN=
# File holding the API's PROMETHEUS_METRICS_TOKEN, readable by the container.
BOULDER_API_METRICS_TOKEN_FILE=/root/.secrets/boulder-api-metrics-token
# Optional: a routing config and Telegram bot token kept outside the repository.
# ALERTMANAGER_CONFIG_FILE=/root/.secrets/alertmanager.yml
# ALERTMANAGER_TELEGRAM_TOKEN_FILE=/root/.secrets/telegram-bot-token
