{
  "name": "boulder-rollers-indexer",
  "version": "0.1.0",
  "description": "Solana indexer for the Boulder Rollers program - IDL-driven account decoding and Postgres persistence",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/web3.js": "^1.95.8",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@coral-xyz/anchor": {
      "toml": "4.2.0"
    }
  }
}
