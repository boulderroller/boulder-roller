# OS junk
.DS_Store

# Deploy-asset data (DEM grids etc.) — generated by tools/dem/, never committed
/data/

# Secrets / local env
.env
.env.local
.env.*.local
.envrc
.mcp.json
.local/
# Local-only production migration rehearsal inputs; never commit these exports.
prod_schema_public.sql
prod_migration_ledger.json
bot/discord-steward/.dev.vars
infrastructure/monitoring/prometheus/secrets/*
!infrastructure/monitoring/prometheus/secrets/.gitkeep
# Allow .env.example templates
!.env.example
!**/.env.example

# Python caches and virtualenvs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
.cache/
venv/
.venv/
*/venv/
*/.venv/

# Node / web tooling
node_modules/
dist/
build/
.parcel-cache/
.turbo/

# Corpus data (large binary files, not tracked)
tools/corpus/*.db
tools/corpus/scorecards/
tools/corpus/reviews/

# MCP server build outputs
tools/mcp-server/node_modules/
tools/mcp-server/dist/

# Rust / Anchor build outputs
target/
**/target/
**/target-debug/
**/target-local/
**/.anchor/
**/deploy-output/
**/test-ledger/

# Supabase temp artifacts
supabase/.temp/
supabase/.branches/

# Xcode / Swift build outputs
client-ios/.build/
client-ios/DerivedData/
client-ios/.swiftpm/
*.xcuserdata/
*.xcuserstate

# Terraform artifacts
infrastructure/terraform/**/*.tfvars
infrastructure/terraform/**/.terraform/
infrastructure/terraform/**/.terraform.lock.hcl
infrastructure/terraform/**/terraform.tfstate*
ios/DerivedData/
infrastructure/terraform/**/*.tfplan
infrastructure/terraform/**/tfplan
ios/**/*.xcuserdata
ios/**/xcuserdata/
payer-devnet.json

# Workout-parse build artifacts
workout-parse/**/*.so
workout-parse/**/*.dylib
workout-parse/**/*.rlib
workout-parse/**/*.d

# MCP server
tools/mcp-server/package-lock.json

# Backend logs
backend/.uvicorn.log

# Generated output artifacts (diagrams, charts, HTML reports)
output/

# Rank-mark production bakes: retain review/provenance, ignore 672 sprites.
!tools/rankmarks/build/
tools/rankmarks/build/*
!tools/rankmarks/build/manifest.json
!tools/rankmarks/build/contact_sheet.png

# Vite build manifests
web/portal/build-manifest/

# SQLite WAL/SHM files (transient)
tools/corpus/*.db-shm
tools/corpus/*.db-wal

# Beads daemon logs (compressed)
.beads/daemon-*.log.gz

# Test validation FIT files (large binaries)
tests/validation/*.fit
tools/osm/*.csv
.vercel

# Private / sensitive (grant strategy, mentor feedback, credentials)
private/
.uvicorn.log
.uvicorn.pid
backend/.uvicorn.pid

# local CARTO key for the ground harness
history/ground-2026-09-06/carto.key

# Local design workshop build and linked dependency runtime
web/portal/workshop-dist/
web/portal/node_modules

# Keypairs never belong in Git, devnet included (scripts/hooks/keypair-guard.sh)
protocol/devnet-deploy.json
*-keypair.json

# Screenshots and recordings stay out of main. history/ keeps text and data;
# media removed on 2026-11-05 is restorable from commit 5931e4540
# (see history/README.md). Use `git add -f` for one a doc must link to.
history/**/*.png
history/**/*.jpg
history/**/*.jpeg
history/**/*.gif
history/**/*.webp
history/**/*.mp4
history/**/*.mov
history/**/*.webm
history/**/*.wav
history/**/*.mp3
history/**/*.m4a
