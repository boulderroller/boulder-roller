{
  "name": "boulderroller-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --quiet",
    "typecheck": "tsc --noEmit --pretty false",
    "smoke:beta": "node scripts/beta-smoke.mjs",
    "prebuild": "expo prebuild",
    "gen:chain-types": "node scripts/gen-chain-types.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@solana/web3.js|@solana-mobile/.*|@privy-io/.*|@tanstack/.*|zustand|react-native-safe-area-context|react-native-screens|@garmin/fitsdk)"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/mocks/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/types.ts"
    ]
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.200.0",
    "@privy-io/expo": "^0.63.0",
    "@privy-io/expo-native-extensions": "^0.0.8",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "^11.4.0",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.14.10",
    "@sentry/react-native": "~6.10.0",
    "@solana-mobile/mobile-wallet-adapter-protocol": "2.2.8",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "2.2.8",
    "@solana-mobile/seed-vault-lib": "^0.4.1",
    "@solana/web3.js": "^1.95.3",
    "@tanstack/react-query": "^5.95.2",
    "buffer": "^6.0.3",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.0",
    "expo-application": "~6.0.2",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.2",
    "expo-file-system": "~18.0.12",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.0",
    "expo-location": "~18.0.10",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "^15.2.14",
    "expo-status-bar": "~2.0.0",
    "expo-task-manager": "~12.0.6",
    "expo-updates": "~0.27.5",
    "expo-web-browser": "~14.0.0",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-ble-plx": "^3.5.1",
    "react-native-get-random-values": "1.11.0",
    "react-native-maps": "1.18.0",
    "react-native-passkeys": "^0.4.0",
    "react-native-qrcode-styled": "^0.3.3",
    "react-native-safe-area-context": "~5.1.0",
    "react-native-screens": "~4.5.0",
    "react-native-svg": "~15.8.0",
    "react-native-webview": "~13.12.0",
    "viem": "^2.47.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^8.0.1",
    "jest": "^30.3.0",
    "jest-expo": "~52.0.0",
    "typescript": "~5.3.0"
  }
}
