TELEGRAM_BOT_TOKEN=your_bot_token_here
BACKEND_API_URL=https://api.boulderroller.org
# Optional: if you store chat links in Supabase
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
# Optional: direct Postgres DSN for bot_links
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Optional: set when running locally with polling instead of webhook
USE_POLLING=true
WEBHOOK_SECRET_TOKEN=replace_me
WEBHOOK_URL=https://your-domain.com/bot/webhook
NOTIFY_INTERVAL_SECONDS=180
# Optional: override Solscan host
# SOLSCAN_BASE=https://solscan.io
