# Database connection (Supabase PostgreSQL or other)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase backend connection (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your-server-key-here

# JWT signing secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here
ACCESS_TOKEN_SECRET=your-access-token-secret-here
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here

# JWT configuration
ENVIRONMENT=development
APP_ENV=development
AUTH_AUDIENCE=boulderrollers
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=14
AUTH_NONCE_TTL_SECONDS=300
AUTH_SIWS_DOMAIN=app.boulderroller.xyz
AUTH_SIWS_URI=https://app.boulderroller.xyz
AUTH_SIWS_CHAIN=solana
AUTH_SIWS_INTENT=login
AUTH_COOKIE_SECURE=false  # Public staging/production always force secure cookies
AUTH_COOKIE_SAMESITE=lax
AUTH_SIGNATURE_BYPASS=false  # Set to true for local dev/test only; ignored on staging/production
ENABLE_DEV_ROUTES=true        # Only honored in non-public environments

# Boulder Roller Balance rollout controls
BALANCE_ROLLOUT_STAGE=off
BALANCE_ROLLOUT_COHORT=internal
BALANCE_ROLLOUT_OWNER=
BALANCE_ROLLOUT_ROLLBACK_OWNER=
BALANCE_ROLLOUT_ROLLBACK_CONTACT=
BALANCE_ROLLOUT_STARTED_AT=
BALANCE_ROLLOUT_ENFORCED=

# Privy authentication (social login)
PRIVY_APP_ID=your-privy-app-id                              # Get from Privy dashboard
PRIVY_VERIFICATION_KEY=your-privy-verification-key          # Get from Privy dashboard

# CORS configuration (comma-separated list for additional origins)
CORS_EXTRA_ORIGINS=
# Optional: override CORS origin regex (default empty = strict allowlist only)
CORS_ALLOW_ORIGIN_REGEX=

# Strava integration (optional - for activity import)
STRAVA_CLIENT_ID=your-strava-client-id                      # Get from https://www.strava.com/settings/api
STRAVA_CLIENT_SECRET=your-strava-client-secret              # Get from Strava API settings
STRAVA_SYNC_ENABLED=false                                   # File-import-only is fail-closed; true re-enables retired OAuth/webhook ingest
STRAVA_REDIRECT_URI=https://app.boulderroller.xyz/strava/callback  # Must match Strava app config

# Ride processing
USE_RUST_PARSER=true                                         # Use Rust workout_parse instead of Python parser
USE_ASYNCPG_BULK=false                                       # Use asyncpg COPY for tile sample inserts (10-50x faster)
CLIMB_ALGORITHM=canonical                                    # Canonical prelaunch detector path
# DEM_GRID_DIR=/app/resources/dem                            # Optional override for the DEM correction grid dir (deploy asset from tools/dem/; missing = corrections abstain)

# Solana configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_STUB=false
# Read-only Stage 1 portal: also requires the on-chain 0x4D version gate.
STAGE1_UI_ENABLED=false
FEE_PAYER_KEYPAIR=                                          # base64 / JSON array / file path
BACKEND_AUTHORITY_KEYPAIR=                                  # base64 / JSON array / file path
EXPECTED_BACKEND_AUTHORITY=                                 # optional base58 assertion guard

# Solana Program IDs (from Worker 1 deployment)
BOULDER_ROLLERS_PROGRAM_ID=your-program-id-here
DUNG_MINT_PROGRAM_ID=your-program-id-here
PROOF_VERIFIER_PROGRAM_ID=your-program-id-here
DUNG_MINT_ADDRESS=your-mint-address-here
