# BoulderRoller backups to Cloudflare R2 (boulderroller-v2-m6rs7).
# Installed as /etc/cron.d/boulder-backups by scripts/backup/install.sh; see
# docs/runbooks/BACKUPS_R2.md. Times are UTC. One lock keeps runs from overlapping.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
17 3 * * *  root flock -w 1800 /run/lock/boulder-backup.lock /root/bin/boulder-backup/backup-db.sh >> /var/log/boulder-backup.log 2>&1
23 4 * * 1  root flock -w 1800 /run/lock/boulder-backup.lock /root/bin/boulder-backup/backup-storage.sh >> /var/log/boulder-backup.log 2>&1
41 5 1 * *  root flock -w 1800 /run/lock/boulder-backup.lock nice -n 10 /root/bin/boulder-backup/restore-test.sh >> /var/log/boulder-backup.log 2>&1
9 * * * *   root /root/bin/boulder-backup/check-freshness.sh >> /var/log/boulder-backup.log 2>&1
